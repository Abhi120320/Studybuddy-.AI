# ─────────────────────────────────────────────────────────────────────────────
# Study Buddy AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / Groq ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Server ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── CORS (set to your frontend URL) ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Docker:  postgresql://studybuddy:studybuddy@postgres:5432/studybuddy
# Local:   postgresql://studybuddy:studybuddy@localhost:5432/studybuddy
DATABASE_URL=postgresql://studybuddy:studybuddy@localhost:5432/studybuddy

# ── JWT ───────────────────────────────────────────────────────────────────
# REQUIRED — must be a random string of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_at_least_32_chars

# Access token lifetime (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP (for OTP email delivery) ────────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_gmail_app_password   ← NOT your Gmail login password
#
# Outlook/Hotmail example:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=your_sendgrid_api_key
#
# If SMTP is not configured, OTP codes will be printed to console
# in development mode only (NODE_ENV=development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudyBuddy AI" <noreply@studybuddy.ai>
